# Copy values into your shell; no dotenv dependency or implicit .env loading.
# Forecast-only MVP is the default. Explicit development enables synthetic replay routes.
AURORA_PROFILE=mvp
AURORA_MODE=offline
AURORA_HOST=127.0.0.1
AURORA_PORT=8000
# From backend/: ../api/examples (explicit path is required outside checkout).
AURORA_FIXTURE_DIR=../api/examples
# Only enable for an explicitly chosen container/device development network:
AURORA_ALLOW_NETWORK=false

# Provider access is independent of listening on a network interface.
AURORA_PROVIDER_NETWORK=false
AURORA_CACHE_PATH=var/providers.sqlite
AURORA_RESPONSE_DEADLINE=3
AURORA_CONTRACT_PATH=../api/openapi.json

