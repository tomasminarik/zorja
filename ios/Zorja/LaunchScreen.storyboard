<?xml version="1.0" encoding="UTF-8"?>
<!-- Launch screen: bg/base with the green glow along the bottom edge. AuroraSkyView draws the
     same glow, at the same size, for the first moments of the app, so the hand-over has no jump. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="Launch-VC">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="Launch-Scene">
            <objects>
                <viewController id="Launch-VC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Launch-Root">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="Launch/LaunchGlow" translatesAutoresizingMaskIntoConstraints="NO" id="Launch-Glow">
                                <rect key="frame" x="0.0" y="612" width="393" height="240"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="240" id="Launch-Glow-H"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Launch-Safe"/>
                        <color key="backgroundColor" name="Launch/LaunchBackground"/>
                        <constraints>
                            <constraint firstItem="Launch-Glow" firstAttribute="leading" secondItem="Launch-Root" secondAttribute="leading" id="Launch-Glow-L"/>
                            <constraint firstAttribute="trailing" secondItem="Launch-Glow" secondAttribute="trailing" id="Launch-Glow-T"/>
                            <constraint firstAttribute="bottom" secondItem="Launch-Glow" secondAttribute="bottom" id="Launch-Glow-B"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="Launch-FR" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
    </scenes>
    <resources>
        <image name="Launch/LaunchGlow" width="402" height="240"/>
        <namedColor name="Launch/LaunchBackground">
            <color red="0.0196" green="0.0275" blue="0.0510" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
